# Normalize line endings. Committed before any SQL lands: CRLF inside
# dollar-quoted PL/pgSQL blocks breaks psql, and diff noise on migrations
# makes review useless.
* text=auto eol=lf

*.sql   text eol=lf
*.sh    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.css   text eol=lf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.pdf   binary
*.ico   binary
